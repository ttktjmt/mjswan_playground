     warn.mockRestore();
   });
 });
+
+describe('applyAction — joint_position_relative', () => {
+  it('re-bases on the live position each call, so it carries no state', () => {
+    const data = fakeData(2, [0.3, -0.1]);
+    const t = term({
+      controlType: 'joint_position_relative',
+      actionScale: Float32Array.from([0.5, 0.5]),
+    });
+    applyAction(data, [t], Float32Array.from([1, 1]));
+    expect(Array.from(data.ctrl)).toEqual([0.8, 0.4]);
+
+    // Same action again, but the sim has moved: the target follows the position, it
+    // does not accumulate. An integrator would read 1.3 / 0.9 here.
+    data.qpos[0] = 0.7;
+    data.qpos[1] = 0.2;
+    applyAction(data, [t], Float32Array.from([1, 1]));
+    expect(Array.from(data.ctrl)).toEqual([1.2, 0.7]);
+  });
+
+  it('clamps the delta, not the finished target — where mjlab applies clip here', () => {
+    const data = fakeData(2, [10, 10]);
+    applyAction(
+      data,
+      [
+        term({
+          controlType: 'joint_position_relative',
+          clipLo: Float32Array.from([-0.25, -0.25]),
+          clipHi: Float32Array.from([0.25, 0.25]),
+        }),
+      ],
+      Float32Array.from([1, -1]),
+    );
+    // Target 10 ± 1 would be clipped away entirely if the bound applied to the sum.
+    expect(Array.from(data.ctrl)).toEqual([10.25, 9.75]);
+  });
+
+  it('still removes the encoder bias from the commanded target', () => {
+    const data = fakeData(2, [0.3, -0.1]);
+    applyAction(
+      data,
+      [
+        term({
+          controlType: 'joint_position_relative',
+          encoderBias: Float32Array.from([0.05, -0.05]),
+        }),
+      ],
+      Float32Array.from([0.1, 0.1]),
+    );
+    expect(data.ctrl[0]).toBeCloseTo(0.3 + 0.1 - 0.05, 6);
+    expect(data.ctrl[1]).toBeCloseTo(-0.1 + 0.1 + 0.05, 6);
+  });
+});
+
+describe('applyAction — joint_pos_target recording', () => {
+  it('records the pre-bias target per qpos address, as mjlab stores the field', () => {
+    // The term's joints live at qpos 2/3, so the buffer is addressed there, not at 0.
+    const data = fakeData(2, [9, 9, 0.3, -0.1]);
+    const out = new Float32Array(4);
+    applyAction(
+      data,
+      [
+        term({
+          controlType: 'joint_position_relative',
+          qposAdr: [2, 3],
+          encoderBias: Float32Array.from([0.05, 0.05]),
+          jointPosTargetOut: out,
+        }),
+      ],
+      Float32Array.from([0.1, 0.2]),
+    );
+    // mjlab's `set_joint_position_target` receives the target before the actuator
+    // takes the bias off, so an observation reading the field must see it unbiased.
+    expect(out[2]).toBeCloseTo(0.3 + 0.1, 6);
+    expect(out[3]).toBeCloseTo(-0.1 + 0.2, 6);
+    // Untouched joints keep mjlab's zero.
+    expect(Array.from(out.subarray(0, 2))).toEqual([0, 0]);
+  });
+
+  it('records an absolute joint_position target too, not just a relative one', () => {
+    const data = fakeData(2, [0, 0]);
+    const out = new Float32Array(2);
+    applyAction(
+      data,
+      [
+        term({
+          defaultJointPos: Float32Array.from([0.5, -0.2]),
+          actionScale: Float32Array.from([2, 2]),
+          jointPosTargetOut: out,
+        }),
+      ],
+      Float32Array.from([0.25, 0.5]),
+    );
+    expect(out[0]).toBeCloseTo(1, 6);
+    expect(out[1]).toBeCloseTo(0.8, 6);
+  });
+});
