+@dataclass(kw_only=True)
+class RelativeJointPositionActionCfg(BaseActionCfg):
+    """Joint position targets relative to the *measured* joint positions.
+
+    ``q_cmd = q(t) + scale * a``. Mirrors
+    ``mjlab.envs.mdp.actions.actions.RelativeJointPositionActionCfg``: the target is
+    re-based on the current position every control step, so — unlike an integrator on
+    the previous command — the term carries no state, and the browser needs none.
+
+    ``offset`` has no meaning when the base is the live position, and mjlab refuses a
+    non-zero one; so does this. ``clip`` bounds the *delta* before it is added, which
+    is where mjlab applies it for this term and nowhere else.
+
+    ``relative_to="command"`` switches the base from the measured position to the term's
+    own previous command, making it an integrator. That variant is **not** mjlab
+    parity — mjlab has only the measured-position form — but it is the standard delta
+    controller in dexterous manipulation (HORA, LEAPSim), and the two are not
+    interchangeable: under contact the measurement lags the command, so an integrator
+    can hold a target the measured-position form can never reach.
+    """
+
+    relative_to: str = "position"
+    """``"position"`` for mjlab's ``q_cmd = q + scale·a``; ``"command"`` for
+    ``q_cmd += scale·a``, which carries state across control steps."""
+
+    clip_to_joint_limits: bool = True
+    """Clamp the target to the joint limits. Only meaningful for ``"command"``: an
+    integrator with no bound drifts past the joint stop and never comes back."""
+
+    soft_joint_pos_limit_factor: float | None = None
+    """mjlab's ``EntityArticulationInfoCfg.soft_joint_pos_limit_factor``, which shrinks
+    each joint's range about its midpoint. The browser derives the limits from its own
+    model's ``jnt_range``, so only the factor has to travel. ``None`` uses the hard
+    limits."""
+
+    interpolate_decimation: bool = False
+    """Ramp the setpoint linearly across the decimation substeps instead of stepping to
+    it at once. Smooths the torque, as mjlab's own actuator delay does."""
+
+    stiffness: float | list[float] | dict[str, float] | None = None
+    """Position gain (kp). mjswan-specific; see :class:`JointPositionActionCfg`."""
+
+    damping: float | list[float] | dict[str, float] | None = None
+    """Velocity gain (kd). mjswan-specific; see :class:`JointPositionActionCfg`."""
+
+    def to_dict(self) -> dict[str, Any]:
+        if self.unsupported_reason is not None:
+            raise NotImplementedError(self.unsupported_reason)
+        if self.offset != 0.0:
+            raise ValueError(
+                "RelativeJointPositionActionCfg takes no `offset`: the target is "
+                "`current_pos + scale * a`, so a fixed offset has no meaning. mjlab "
+                "raises the same error in its own `__post_init__`."
+            )
+        if self.relative_to not in ("position", "command"):
+            raise ValueError(
+                f"relative_to must be 'position' or 'command', got "
+                f"{self.relative_to!r}."
+            )
+
+        entry: dict[str, Any] = {"type": "joint_position_relative"}
+        if self.scale != 1.0:
+            entry["scale"] = self.scale
+        entry["actuator_names"] = list(self.actuator_names)
+        entry["relative_to"] = self.relative_to
+        if self.relative_to == "command":
+            entry["clip_to_joint_limits"] = self.clip_to_joint_limits
+            if self.soft_joint_pos_limit_factor is not None:
+                entry["soft_joint_pos_limit_factor"] = float(
+                    self.soft_joint_pos_limit_factor
+                )
+            if self.interpolate_decimation:
+                entry["interpolate_decimation"] = True
+        if self.stiffness is not None:
+            entry["stiffness"] = self.stiffness
+        if self.damping is not None:
+            entry["damping"] = self.damping
+        self._add_clip(entry)
+        return entry
+
